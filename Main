-- HTTP ADAPTER
-- Requires an HTTP request function supplied by your environment.
-- API keys should never be placed in a public client-side script.

local function getRequestFunction()
    if type(request) == "function" then
        return request
    end

    if type(http_request) == "function" then
        return http_request
    end

    return nil
end

local function apiGet(path)
    local req = getRequestFunction()
    if not req then
        return nil, "HTTP request function unavailable"
    end

    local ok, response = pcall(function()
        return req({
            Url = API .. path,
            Method = "GET",
            Headers = {
                ["Accept"] = "application/json"
            }
        })
    end)

    if not ok or type(response) ~= "table" then
        return nil, "Network request failed"
    end

    local status = tonumber(response.StatusCode or response.Status)
    if not status or status < 200 or status >= 300 then
        return nil, "HTTP " .. tostring(status or "error")
    end

    local decoded, result = pcall(function()
        return HttpService:JSONDecode(response.Body)
    end)

    if not decoded or type(result) ~= "table" then
        return nil, "Invalid API response"
    end

    if result.success == false then
        return nil, "API returned an error"
    end

    return result
end

local function enc(value)
    return HttpService:UrlEncode(tostring(value or ""))
end

local function makeQuery(params)
    local parts = {}

    for key, value in pairs(params) do
        if value ~= nil then
            table.insert(
                parts,
                enc(key) .. "=" .. enc(value)
            )
        end
    end

    table.sort(parts)
    return "?" .. table.concat(parts, "&")
end

-- GUI HELPERS

local oldGui = nil
pcall(function()
    local pg = Player:FindFirstChildOfClass("PlayerGui")
    if pg then
        oldGui = pg:FindFirstChild("SWX_RSCRIPTS_HUB")
    end
end)

if oldGui then
    oldGui:Destroy()
end

local Gui = Instance.new("ScreenGui")
Gui.Name = "SWX_RSCRIPTS_HUB"
Gui.ResetOnSpawn = false
Gui.DisplayOrder = 20

pcall(function()
    if gethui then
        Gui.Parent = gethui()
    else
        Gui.Parent = Player:WaitForChild("PlayerGui")
    end
end)

if not Gui.Parent then
    Gui.Parent = Player:WaitForChild("PlayerGui")
end

local function create(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function round(obj, radius)
    create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, obj)
end

local function stroke(obj, color, transparency)
    create("UIStroke", {
        Color = color or C.Border,
        Transparency = transparency or 0,
        Thickness = 1
    }, obj)
end

local function button(parent, text, size, pos)
    local b = create("TextButton", {
        Size = size,
        Position = pos,
        BackgroundColor3 = C.Card,
        BorderSizePixel = 0,
        Text = text,
        TextColor3 = C.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium,
        AutoButtonColor = false
    }, parent)

    round(b, 8)
    stroke(b, C.Border)

    b.MouseEnter:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = C.Border
        }):Play()
    end)

    b.MouseLeave:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = C.Card
        }):Play()
    end)

    return b
end

local function label(parent, text, size, pos, textSize, color)
    return create("TextLabel", {
        Size = size,
        Position = pos,
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = color or C.Text,
        TextSize = textSize or 13,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true
    }, parent)
end


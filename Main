local FilterFrame = create("Frame", {
    Size = UDim2.new(1, 0, 0, 74),
    Position = UDim2.new(0, 0, 0, 46),
    BackgroundTransparency = 1
}, Content)

local FilterLayout = create("UIGridLayout", {
    CellSize = UDim2.new(0.25, -5, 0, 30),
    CellPadding = UDim2.new(0, 5, 0, 6),
    SortOrder = Enum.SortOrder.LayoutOrder
}, FilterFrame)

local filterButtons = {}

local filterDefinitions = {
    {"Free", "Free"},
    {"Mobile", "Mobile"},
    {"No Key", "NoKey"},
    {"Verified", "Verified"}
}

local function updateFilterButtons()
    for _, entry in ipairs(filterDefinitions) do
        local name, key = entry[1], entry[2]
        local active = State[key]

        local b = filterButtons[key]
        if b then
            b.Text = name .. (active and " ✓" or "")
            b.BackgroundColor3 = active and C.Purple or C.Card
        end
    end
end

for i, entry in ipairs(filterDefinitions) do
    local name, key = entry[1], entry[2]

    local b = button(
        FilterFrame, name,
        UDim2.new(0.25, -5, 0, 30),
        UDim2.new(0, 0, 0, 0)
    )

    b.LayoutOrder = i
    filterButtons[key] = b

    b.MouseButton1Click:Connect(function()
        State[key] = not State[key]
        State.Page = 1
        updateFilterButtons()

        if State.Tab == "Browse" then
            renderPage()
        end
    end)
end


-- DETAILS VIEW

local function clearResults()
    for _, child in ipairs(Results:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel")
            or child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

local function addInfo(parent, title, value, y)
    label(
        parent, title, UDim2.new(1, -20, 0, 20),
        UDim2.new(0, 10, 0, y), 11, C.Light
    )

    label(
        parent, tostring(value or "Not provided"),
        UDim2.new(1, -20, 0, 44),
        UDim2.new(0, 10, 0, y + 19), 12, C.Text
    )
end

local function riskLabel(risk)
    if type(risk) ~= "table" or risk.score == nil then
        return "UNKNOWN - NOT SCANNED", C.Yellow
    end

    local score = tonumber(risk.score)
    if not score or score < 1 or score > 10 then
        return "UNKNOWN - INVALID SCORE", C.Yellow
    end

    if score >= 8 then
        return "HIGH RISK / " .. score .. "/10", C.Red
    elseif score >= 5 then
        return "MEDIUM RISK / " .. score .. "/10", C.Yellow
    end

    return "LOWER RISK / " .. score .. "/10", C.Green
end

local function showDetails(item)
    clearResults()

    local slug = item.slug
    if type(slug) ~= "string" then
        setStatus("This result has no valid slug", C.Red)
        return
    end

    setStatus("Loading details...")

    task.spawn(function()
        local data, err = apiGet("/v1/scripts/" .. enc(slug))

        if not data then
            setStatus("Details failed: " .. tostring(err), C.Red)
            return
        end

        if type(data.data) == "table" then
            data = data.data
        end

        clearResults()

        local card = create("Frame", {
            Size = UDim2.new(1, -6, 0, 430),
            BackgroundColor3 = C.Panel,
            BorderSizePixel = 0
        }, Results)

        round(card, 10)
        stroke(card, C.Border)

        local title = label(
            card, tostring(data.title or item.title or "Untitled"),
            UDim2.new(1, -20, 0, 48),
            UDim2.new(0, 10, 0, 8), 16, C.Light
        )
        title.Font = Enum.Font.GothamBold

        local risk, riskColor = riskLabel(data.risk)

        label(
            card, "RISK: " .. risk,
            UDim2.new(1, -20, 0, 24),
            UDim2.new(0, 10, 0, 59), 12, riskColor
        ).Font = Enum.Font.GothamBold

        addInfo(card, "CREATOR",
            type(data.creator) == "table"
                and data.creator.username or "Unknown", 88)

        addInfo(card, "GAME",
            type(data.game) == "table"
                and data.game.title or "Unknown", 150)

        addInfo(card, "DESCRIPTION",
            tostring(data.description or "No description"), 212)

        local likes = tonumber(data.likes) or 0
        local views = tonumber(data.views) or 0

        label(
            card, "Views: " .. views .. "  •  Likes: " .. likes,
            UDim2.new(1, -20, 0, 22),
            UDim2.new(0, 10, 0, 288), 11, C.Muted
        )

        local riskObj = data.risk
        if type(riskObj) == "table"
            and type(riskObj.findings) == "table"
            and #riskObj.findings > 0 then

            local first = riskObj.findings[1]
            local findingText = type(first) == "table"
                and tostring(first.label or "Finding")
                or "Finding"

            label(
                card, "Finding: " .. findingText,
                UDim2.new(1, -20, 0, 28),
                UDim2.new(0, 10, 0, 314), 11, C.Yellow
            )
        end

        local back = button(
            card, "← BACK TO RESULTS",
            UDim2.new(0.55, 0, 0, 34),
            UDim2.new(0, 10, 1, -45)
        )

        back.MouseButton1Click:Connect(function()
            renderPage()
        end)

        setStatus(
            "Details loaded • Source is never executed",
            C.Green
        )
    end)
end

-- RESULT CARDS

local function addScriptCard(item, index)
    local card = create("Frame", {
        Name = "ScriptCard",
        Size = UDim2.new(1, -6, 0, 102),
        BackgroundColor3 = C.Panel,
        BorderSizePixel = 0,
        LayoutOrder = index
    }, Results)

    round(card, 10)
    stroke(card, C.Border)

    local title = label(
        card, tostring(item.title or "Untitled"),
        UDim2.new(1, -118, 0, 35),
        UDim2.new(0, 10, 0, 8), 13, C.Text
    )
    title.Font = Enum.Font.GothamBold

    local creator = type(item.creator) == "table"
        and item.creator.username or "Unknown creator"

    local game = type(item.game) == "table"
        and item.game.title or "Unknown game"

    label(
        card, tostring(creator) .. " • " .. tostring(game),
        UDim2.new(1, -118, 0, 22),
        UDim2.new(0, 10, 0, 43), 10, C.Muted
    )

    local risk, riskColor = riskLabel(item.risk)

    label(
        card, risk,
        UDim2.new(1, -118, 0, 20),
        UDim2.new(0, 10, 0, 70), 10, riskColor
    )

    local details = button(
        card, "DETAILS",
        UDim2.new(0, 90, 0, 30),
        UDim2.new(1, -100, 0, 12)
    )

    details.MouseButton1Click:Connect(function()
        showDetails(item)
    end)

    local stats = label(
        card,
        "Views " .. tostring(item.views or 0)
            .. "  •  Likes " .. tostring(item.likes or 0),
        UDim2.new(0, 102, 0, 25),
        UDim2.new(1, -108, 0, 54), 9, C.Muted
    )
    stats.TextXAlignment = Enum.TextXAlignment.Center
end

-- API DATA RENDERING

renderPage = function()
    if State.Busy then
        return
    end

    State.Busy = true
    State.RequestId += 1

    local requestId = State.RequestId
    clearResults()
    setStatus("Loading " .. State.Tab .. "...")

    task.spawn(function()
        local data, err, meta

        if State.Tab == "Trending" then
            data, err = apiGet("/v1/trending")
        elseif State.Tab == "Search" then
            local path = "/v1/search" .. makeQuery({
                q = State.Query,
                index = "scripts",
                limit = State.Limit,
                page = State.Page
            })

            data, err, meta = apiGet(path)
        else
            local params = {
                page = State.Page,
                limit = State.Limit,
                sort = State.Sort,
                freeOnly = State.Free,
                mobileOnly = State.Mobile,
                noKeySystem = State.NoKey,
                verifiedOnly = State.Verified
            }

            if State.Query ~= "" then
                params.q = State.Query
            end

            data, err, meta = apiGet(
                "/v1/scripts" .. makeQuery(params)
            )
        end

        if requestId ~= State.RequestId then
            return
        end

        State.Busy = false

        if not data then
            setStatus("API error: " .. tostring(err), C.Red)
            return
        end

        local items = {}

        if State.Tab == "Trending" then
            local rising = type(data.rising) == "table"
                and data.rising or {}

            local trending = type(data.trending) == "table"
                and data.trending or {}

            for _, item in ipairs(rising) do
         
